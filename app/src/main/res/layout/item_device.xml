<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingHorizontal="32dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp">
    <!-- @drawable/circle_background -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"

        >


        <ImageView
            android:id="@+id/device_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="icons"
            android:src="@android:drawable/ic_menu_info_details"
            app:tint="?attr/textDeviceIconsTint"
            tools:tint="#2196F3" />

            <com.lihang.ShadowLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp"
                app:hl_layoutBackground="@android:color/transparent"
                app:hl_angle="0"

                app:hl_cornerRadius="40dp"
                app:hl_shadowColor="#7AE9E9E9"
                app:hl_shadowLimit="4dp"


                app:hl_shadowOffsetX="0dp"
                app:hl_shadowOffsetY="0dp"
                app:hl_strokeWith="0dp"



                >

                <LinearLayout
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/item_device_background_devider_icon"
                    tools:background="#9996F3"
                    android:outlineProvider="background"
                    />

            </com.lihang.ShadowLayout>



        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/device_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Название"
                    android:textColor="?attr/textDeviceTint"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Название"
                    tools:textColor="@color/black"

                    />

                <ImageView
                    android:id="@+id/active"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="1dp"
                    android:alpha="1"
                    android:src="@drawable/ic_active_device" />
                <ImageView
                    android:id="@+id/inactive"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="1dp"
                    android:alpha="0"
                    android:src="@drawable/ic_active_non_device" />
            </LinearLayout>

            <TextView
                android:id="@+id/device_network"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Нет сети"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/device_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="192.168.1.100"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center_horizontal|top"

            android:layout_marginEnd="12dp"
            >

            <ImageView
                android:id="@+id/message_icon"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:contentDescription="icons"
                android:src="@drawable/ic_message"
                android:visibility="gone"
                app:tint="?attr/textDeviceIconsTint"
                tools:tint="#2196F3" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="70dp"
        android:background="@drawable/item_device_background_white"
        tools:background="#9996F3"
        tools:tint="#9996F3"

        />

</LinearLayout>